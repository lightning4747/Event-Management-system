# ─────────────────────────────────────────────────────────
#  MCET OD Portal — Backend Local Dev Environment
#  Copy this file to .env for LOCAL development (no Docker).
#  For Docker, use the ROOT .env file instead.
# ─────────────────────────────────────────────────────────

DATABASE_URL=postgres://postgres:password123@localhost:5432/od_approval_db
JWT_SECRET=local_dev_secret_change_this_minimum_32_characters
JWT_EXPIRES_IN=7d
PORT=8000
STORAGE_PROVIDER=local

# ── Google Drive Storage (Service Account) ───────────────
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Optional direct JSON or key file path fallbacks:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
GOOGLE_DRIVE_PARENT_FOLDER_ID=1S3WBt19OTEONmQlvHF-3KdYvio_BAiGt