# ─────────────────────────────────────────────────────────
#  MCET OD Portal — Backend Local Dev Environment
#  Copy this file to .env for LOCAL development (no Docker).
#  For Docker, use the ROOT .env file instead.
# ─────────────────────────────────────────────────────────

DATABASE_URL=postgres://postgres:password123@localhost:5432/od_approval_db
JWT_SECRET=local_dev_secret_change_this_minimum_32_characters
JWT_EXPIRES_IN=7d
PORT=8000
STORAGE_PROVIDER=local

# ── Amazon S3 Storage ─────────────────────────────────────
# Set STORAGE_PROVIDER=s3 and fill in these values for S3 access.
# Leave STORAGE_PROVIDER=local for local development without AWS.
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET_NAME=mcet-od-portal