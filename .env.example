# ─────────────────────────────────────────────────────────
#  MCET OD Portal — Environment Configuration
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to git — it is gitignored.
# ─────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=od_approval_db

# ── Backend ──────────────────────────────────────────────
# Generate a strong random secret for production:
#   openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Storage: "local" (default) or "onedrive"
STORAGE_PROVIDER=local

# ── OneDrive (only required if STORAGE_PROVIDER=onedrive) ─
ONEDRIVE_TENANT_ID=your-tenant-id-here
ONEDRIVE_CLIENT_ID=your-client-id-here
ONEDRIVE_CLIENT_SECRET=your-client-secret-here
ONEDRIVE_USER_ID=faculty_account@domain.com
